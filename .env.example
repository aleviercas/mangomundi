# Supabase (server-side)
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
# Service-role key (admin, bypasses RLS). Server-only — NEVER expose to the client.
# Previously injected automatically by Lovable Cloud; now set it explicitly.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client-side, exposed to the browser via Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AI gateway (OpenRouter — https://openrouter.ai/keys). Server-only.
# Replaces the former Lovable AI gateway. Used by the FX recommender, chat
# agent, and the i18n translate script.
OPENROUTER_API_KEY=

# Email notifications (Resend — https://resend.com/api-keys). Server-only.
# Fires on every business/RFQ lead capture (agent.functions.ts, rfq.functions.ts).
# Without RESEND_API_KEY, sends are silently skipped — the lead still saves to
# Supabase either way, this is just the internal heads-up email.
RESEND_API_KEY=
# Optional. Defaults to Resend's shared test sender (onboarding@resend.dev),
# which works immediately with no setup. Once mangomundi.com is verified in
# the Resend dashboard (SPF/DKIM), set this to e.g. "mangomundi <hello@mangomundi.com>".
RESEND_FROM_EMAIL=
# Optional. Defaults to hello@mangomundi.com.
LEAD_NOTIFICATION_EMAIL=
